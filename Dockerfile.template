ARG base=balenalib/%%BALENA_MACHINE_NAME%%-alpine
ARG golang=zot.jamet.me/docker-hub/library/golang:1.27

FROM ${golang} as build

RUN mkdir /src
WORKDIR /src
COPY go.* /src/
COPY pkg /src/pkg
COPY bin /src/bin
RUN CGO_ENABLED=0 go build -a -tags netgo -ldflags '-w' -o /bin/monitor bin/net-monitor/main.go

FROM ${base} as speedtest
RUN case "$(uname -m)" in armv7l|armv6l) a=armhf;; *) a=$(uname -m);; esac; \
    wget -O - https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-linux-${a}.tgz | tar xzvf -
RUN mv speedtest /bin/speedtest

FROM ${base}
COPY --from=build /bin/monitor /bin/monitor
COPY --from=speedtest /bin/speedtest /bin/speedtest
ENTRYPOINT ["/bin/monitor"]
